---
import sitemeta from '../components/sitemeta.astro';
import config from "@/config/config.json"

const {
  title = 'MA NU 01 BANYUPUTIH',
  description = 'A starter project with accessibility features using Astro static site builder. Contains accessible landmarks, skip links, a dark mode color scheme, better focus outline and keyboard menu navigation.',
  url = Astro.site,
  image = 'social-preview-image.png',
  author = 'Mark Teekman',
} = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="dcterms.rightsHolder" content="MANSABA JAYA">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{title}</title>
		<link rel="stylesheet" href="/index.css">
		<link rel="apple-touch-icon" sizes="180x180" href={config.logo}>
		<link rel="icon" type="image/png" sizes="32x32" href={config.logo}>
		<link rel="icon" type="image/png" sizes="16x16" href={config.logo}>
		<link rel="icon" href={config.logo}>
		<style>
		.hidden {
			display: none;
		}
		</style>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
