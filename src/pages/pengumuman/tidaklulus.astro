---
import Layout from "../../layouts/Layout.astro"
import config from "@/config/config.json"
---
<Layout title="Tidak Lulus">
    <body id="body"><div id="main" class="main">
        <div id="main-background" class="main-background"></div>
        <div id="main-route" class="main-route"><div id="index" class="index"><div id="index-rejected" class="index-rejected">
        <div class="index-rejected-header">
            <img src={config.logo} alt="Logo" class="index-rejected-header-icon">
            <div class="header-title">
                <h1 class="index-rejected-header-title-text">ANDA DINYATAKAN TIDAK LULUS MA NU 01 BANYUPUTIH</h1>
                <span class="index-rejected-header-title-sub">MASIH ADA KESEMPATAN UNTUK MENGIKUTI UJIAN TAHUN DEPAN. SEMANGAT</span>
            </div>
        </div>
        <div class="index-rejected-content">
            <div class="index-rejected-content-upper">
                <div class="index-accepted-content-upper-bio">
                    <span class="index-accepted-content-upper-bio-nisn" id="index-accepted-nisn">NISN ...</span>
                    <span class="index-accepted-content-upper-bio-name" id="index-accepted-name">Loading...</span>
                    <span class="index-accepted-content-upper-bio-program" id="index-accepted-program">Loading...</span>
                </div>
                <!-- <img class="index-accepted-content-upper-qr" alt="QR" id="index-accepted-qr" src="data:image/png;base64, "> -->
            </div>
            <div class="index-accepted-content-lower">
                <div class="index-accepted-content-lower-column index-accepted-content-lower-column-25">
                    <div class="index-accepted-content-lower-column-field">
                        <span class="index-accepted-content-lower-column-field-caption">Tanggal Lahir</span>
                        <span class="index-accepted-content-lower-column-field-value" id="index-accepted-birthday">Loading...</span>
                    </div>
                    <div class="index-accepted-content-lower-column-field">
                        <span class="index-accepted-content-lower-column-field-caption">Sekolah</span>
                        <span class="index-accepted-content-lower-column-field-value" id="index-accepted-school">Loading...</span>
                    </div>
                </div>
                <div class="index-accepted-content-lower-column index-accepted-content-lower-column-25">
                    <div class="index-accepted-content-lower-column-field">
                        <span class="index-accepted-content-lower-column-field-caption">Kabupaten/Kota</span>
                        <span class="index-accepted-content-lower-column-field-value" id="index-accepted-regency">Loading...</span>
                    </div>
                    <div class="index-accepted-content-lower-column-field">
                        <span class="index-accepted-content-lower-column-field-caption">Provinsi</span>
                        <span class="index-accepted-content-lower-column-field-value" id="index-accepted-province">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div></div></div>
<script src='../../../js/lulus.js'></script>
</body>
</Layout>

