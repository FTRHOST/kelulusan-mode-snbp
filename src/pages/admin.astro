---
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Admin Panel</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    section { margin-bottom: 40px; }
    label { display: block; margin-top: 10px; }
    input, textarea { width: 300px; padding: 5px; margin-top: 5px; }
    button { margin-top: 10px; padding: 5px 10px; }
    ul { list-style-type: none; padding: 0; }
    li { margin-bottom: 10px; }
    .student-item { display: flex; align-items: center; gap: 10px; }
    .student-item span { flex-grow: 1; }
  </style>
</head>
<body>
  <h1>Admin Panel</h1>

  <section id="website-info">
    <h2>Website Info</h2>
    <label for="site-title">Title:</label>
    <input type="text" id="site-title" name="site-title" />
    <label for="site-description">Description:</label>
    <textarea id="site-description" name="site-description" rows="3"></textarea>
    <br />
    <button id="save-config">Save Website Info</button>
  </section>

  <section id="student-management">
    <h2>Manage Students</h2>

    <h3>Add New Student</h3>
    <label for="new-nis">NIS:</label>
    <input type="text" id="new-nis" name="new-nis" />
    <label for="new-nama">Nama:</label>
    <input type="text" id="new-nama" name="new-nama" />
    <label for="new-kelas">Kelas:</label>
    <input type="text" id="new-kelas" name="new-kelas" />
    <label for="new-status">Status Kelulusan:</label>
    <input type="text" id="new-status" name="new-status" />
    <br />
    <button id="add-student">Add Student</button>

    <h3>Student List</h3>
    <ul id="student-list"></ul>
  </section>

  <script>
    function getInputValue(id) {
      const el = document.getElementById(id);
      return el ? el.value : '';
    }

    function setInputValue(id, value) {
      const el = document.getElementById(id);
      if (el) el.value = value;
    }

    async function fetchConfig() {
      const res = await fetch('/api/admin/config');
      if (res.ok) {
        const data = await res.json();
        setInputValue('site-title', data.title || '');
        setInputValue('site-description', data.description || '');
      }
    }

    async function saveConfig() {
      const title = getInputValue('site-title');
      const description = getInputValue('site-description');
      const res = await fetch('/api/admin/config', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, description }),
      });
      if (res.ok) {
        alert('Website info saved successfully.');
      } else {
        alert('Failed to save website info.');
      }
    }

    async function fetchStudents() {
      const res = await fetch('/api/admin/students');
      if (res.ok) {
        const students = await res.json();
        const list = document.getElementById('student-list');
        if (!list) return;
        list.innerHTML = '';
        students.forEach(student => {
          const li = document.createElement('li');
          li.className = 'student-item';
          li.dataset.nis = student.nis;

          const span = document.createElement('span');
          span.textContent = `${student.nis} - ${student.nama} - ${student.kelas || ''} - ${student.status_kelulusan || ''}`;
          li.appendChild(span);

          const editBtn = document.createElement('button');
          editBtn.textContent = 'Edit';
          editBtn.onclick = () => editStudent(li, student);
          li.appendChild(editBtn);

          const deleteBtn = document.createElement('button');
          deleteBtn.textContent = 'Delete';
          deleteBtn.onclick = () => deleteStudent(student.nis);
          li.appendChild(deleteBtn);

          list.appendChild(li);
        });
      }
    }

    function editStudent(li, student) {
      li.innerHTML = '';

      const nisInput = document.createElement('input');
      nisInput.type = 'text';
      nisInput.value = student.nis;
      nisInput.disabled = true;
      li.appendChild(nisInput);

      const namaInput = document.createElement('input');
      namaInput.type = 'text';
      namaInput.value = student.nama;
      li.appendChild(namaInput);

      const kelasInput = document.createElement('input');
      kelasInput.type = 'text';
      kelasInput.value = student.kelas || '';
      li.appendChild(kelasInput);

      const statusInput = document.createElement('input');
      statusInput.type = 'text';
      statusInput.value = student.status_kelulusan || '';
      li.appendChild(statusInput);

      const saveBtn = document.createElement('button');
      saveBtn.textContent = 'Save';
      saveBtn.onclick = async () => {
        const updatedStudent = {
          nis: student.nis,
          nama: namaInput.value,
          kelas: kelasInput.value,
          status_kelulusan: statusInput.value,
        };
        const res = await fetch('/api/admin/students', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(updatedStudent),
        });
        if (res.ok) {
          fetchStudents();
        } else {
          alert('Failed to update student.');
        }
      };
      li.appendChild(saveBtn);

      const cancelBtn = document.createElement('button');
      cancelBtn.textContent = 'Cancel';
      cancelBtn.onclick = () => fetchStudents();
      li.appendChild(cancelBtn);
    }

    async function addStudent() {
      const nis = getInputValue('new-nis').trim();
      const nama = getInputValue('new-nama').trim();
      const kelas = getInputValue('new-kelas').trim();
      const status = getInputValue('new-status').trim();

      if (!nis || !nama) {
        alert('NIS and Nama are required.');
        return;
      }

      const res = await fetch('/api/admin/students', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nis, nama, kelas, status_kelulusan: status }),
      });

      if (res.ok) {
        setInputValue('new-nis', '');
        setInputValue('new-nama', '');
        setInputValue('new-kelas', '');
        setInputValue('new-status', '');
        fetchStudents();
      } else {
        alert('Failed to add student.');
      }
    }

    async function deleteStudent(nis) {
      if (!confirm('Are you sure you want to delete this student?')) return;
      const res = await fetch('/api/admin/students', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nis }),
      });
      if (res.ok) {
        fetchStudents();
      } else {
        alert('Failed to delete student.');
      }
    }

    document.getElementById('save-config')?.addEventListener('click', saveConfig);
    document.getElementById('add-student')?.addEventListener('click', addStudent);

    fetchConfig();
    fetchStudents();
  </script>
</body>
</html>
